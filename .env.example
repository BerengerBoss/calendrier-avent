# Copiez ce fichier en ".env.local" pour lancer le site en local (npm run dev).
# Valeurs : Supabase > Project Settings > API (ou "Connect").
# La clé "anon" / "publishable" est PUBLIQUE par conception : la sécurité est assurée par le RLS du fichier supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-ou-publishable
